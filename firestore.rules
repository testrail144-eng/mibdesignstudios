rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Users (roles) ----
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwnUser(uid);
      // A user can edit their own name; only an admin can change roles.
      allow update: if isOwnUser(uid) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---- Studio settings ----
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- Projects & their subcollections ----
    match /projects/{pid} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Financial / admin-only data
      match /boq/{id}        { allow read, write: if isAdmin(); }
      match /vendors/{id}    { allow read, write: if isAdmin(); }
      match /pos/{id}        { allow read, write: if isAdmin(); }
      match /quotations/{id} { allow read, write: if isAdmin(); }
      match /milestones/{id} { allow read, write: if isAdmin(); }
      match /invoices/{id}   { allow read, write: if isAdmin(); }

      // Operational data: any signed-in user (admin or staff) can read/write
      match /updates/{id}    { allow read, write: if signedIn(); }
      match /snags/{id}      { allow read, write: if signedIn(); }

      // Tasks: everyone can read; staff can only create tasks they own or
      // update tasks assigned to them.
      match /tasks/{id} {
        allow read: if signedIn();
        allow create: if isAdmin() ||
          (signedIn() && request.resource.data.assignedTo == request.auth.uid);
        allow update: if isAdmin() ||
          (signedIn() && resource.data.assignedTo == request.auth.uid);
        allow delete: if isAdmin();
      }
    }
  }
}
