rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Users (roles) ----
    match /users/{uid} {
      allow read: if signedIn();
      // The first-account bootstrap behaviour is retained for existing
      // installations. After an account exists, only an admin can change its
      // role; a member can update their own profile without changing role.
      allow create: if isOwnUser(uid) &&
        (request.resource.data.role == 'admin' || request.resource.data.role == 'staff');
      allow update: if isAdmin() ||
        (isOwnUser(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // ---- Admin-prepared team invitations ----
    // The document id is the normalized email address. A signed-in member can
    // read only the invitation addressed to their own email so sign-up can
    // apply the invited role automatically.
    match /teamInvites/{emailKey} {
      allow read: if isAdmin() ||
        (signedIn() && emailKey == request.auth.token.email);
      allow create, update, delete: if isAdmin();
    }

    // ---- Studio settings ----
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- Projects & their subcollections ----
    match /projects/{pid} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Financial / admin-only data
      match /boq/{id}        { allow read, write: if isAdmin(); }
      match /vendors/{id}    { allow read, write: if isAdmin(); }
      match /pos/{id}        { allow read, write: if isAdmin(); }
      match /quotations/{id} { allow read, write: if isAdmin(); }
      match /milestones/{id} { allow read, write: if isAdmin(); }
      match /invoices/{id}   { allow read, write: if isAdmin(); }

      // Expense entries: staff can see and manage only their own entries;
      // admins can see, approve and manage every entry on the site.
      match /expenses/{id} {
        allow read: if isAdmin() ||
          (signedIn() && resource.data.createdBy == request.auth.uid);
        allow create: if signedIn() &&
          request.resource.data.createdBy == request.auth.uid &&
          ((isAdmin() && request.resource.data.createdRole == 'admin') ||
           (!isAdmin() && request.resource.data.createdRole == 'staff'));
        allow update: if isAdmin() ||
          (signedIn() && resource.data.createdBy == request.auth.uid &&
           request.resource.data.createdBy == request.auth.uid);
        allow delete: if isAdmin() ||
          (signedIn() && resource.data.createdBy == request.auth.uid);
      }

      // Operational data: any signed-in user (admin or staff) can read/write.
      match /updates/{id}    { allow read, write: if signedIn(); }
      match /snags/{id}      { allow read, write: if signedIn(); }

      // Site attendance photos and timestamps. Everyone on the signed-in team
      // can see attendance; only the member who owns a visit (or an admin) can
      // complete/update it.
      match /attendance/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin() ||
          (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
        allow delete: if isAdmin();
      }

      // Tasks: everyone can read; staff can only create tasks they own or
      // update tasks assigned to them.
      match /tasks/{id} {
        allow read: if signedIn();
        allow create: if isAdmin() ||
          (signedIn() && request.resource.data.assignedTo == request.auth.uid);
        allow update: if isAdmin() ||
          (signedIn() && resource.data.assignedTo == request.auth.uid);
        allow delete: if isAdmin();
      }

      // Admin-only audit feed. The client writes a compact event after a new
      // record is created; the server uses the same event for Gmail alerts.
      match /activity/{id} {
        allow read: if isAdmin();
        allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }
  }
}
